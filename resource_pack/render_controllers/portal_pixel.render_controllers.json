          "array.samples": [
            "texture.air",
            "texture.stone",
            "texture.grass",
            "texture.leaves",
            "texture.dirt",
            "texture.wood",
            "texture.sand",
            "texture.water",
            "texture.lava",
            "texture.snow",
            "texture.dark",
            "texture.ore"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
